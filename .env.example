# Optional model calls. Leave disabled for the offline quickstart.
DEMO_LIVE_APPROVED=0
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENROUTER_API_KEY=

# Fixed fictional supplier and optional loopback finance endpoint.
DEMO_SUPPLIER_ID=SUP-PMI
DEMO_API_BASE_URL=
# Use different, random values of at least 16 characters when running the service.
DEMO_API_TOKEN=
DEMO_EXECUTION_TOKEN=
DEMO_REVIEW_TOKEN=

# Hosted workspace only. Supply secrets from a secret manager in deployment.
DEMO_RUN_BUCKET=
GOOGLE_CLOUD_PROJECT=
DEMO_WORKSPACE_ORIGIN=
DEMO_PASSWORD_HASH=
